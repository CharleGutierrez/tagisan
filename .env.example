# =========================================================
# 🇵🇭 TAGISAN: API KEYS CONFIGURATION
# Copy this file to .env and fill in your respective API keys.
# =========================================================

# Anthropic Claude (Claude 3.5 Sonnet / Haiku / Opus)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# xAI Grok (Grok 2 / Grok 3)
XAI_API_KEY=your_xai_api_key_here

# Google Gemini (Gemini 2.0 Flash / 1.5 Pro)
GEMINI_API_KEY=your_gemini_api_key_here

# DeepSeek (DeepSeek V3 / R1 Reasoner)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# OpenAI (GPT-4o / o1 / o3)
OPENAI_API_KEY=your_openai_api_key_here

# Local Ollama is available out of the box at http://localhost:11434 (no key required)
